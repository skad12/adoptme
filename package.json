{
  "name": "adoptme",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter ./apps/web dev & pnpm --filter ./apps/api dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:api": "pnpm --filter ./apps/api dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint"
  },
  "engines": {
    "node": ">=20"
  }
}
