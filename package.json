{
  "name": "adoptme",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:web": "turbo dev --filter=adoptme-web",
    "dev:api": "turbo dev --filter=adoptme-api",
    "build": "turbo build",
    "lint": "turbo lint"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "turbo": "^2.9.16"
  }
}
